SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Required for the classifying commands (smart-add, analyze-only, review-playlist,
# bulk-playlist, scan-for, audit-playlist). add, like, remove and the batch commands work without it.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override the classifier model (defaults to gpt-4.1-mini).
# OPENAI_MODEL=gpt-4.1-mini
