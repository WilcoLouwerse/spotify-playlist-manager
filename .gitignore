# Secrets — never commit
.env
.env.*
!.env.example
.spotify_token_cache
.tracks_log.json
.adds_log.json  # legacy name (pre-2026-05-15 rename); kept ignored for upgraders
*.cache

# Local playlist config — sample lives in playlists.example.json
playlists.json

# Local Exportify CSV dumps — folder is tracked, contents are not
exportify-exports/*
!exportify-exports/.gitkeep

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local scratch (in-progress scans, drafts)
.scratch/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
